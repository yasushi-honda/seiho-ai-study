---
interface Attribute {
  label: string;
  /**
   * 表示するHTML断片（リンク等の埋め込みを許可するため set:html で描画）。
   * MDXの信頼済みコンテンツからのみ渡すこと（外部入力を渡さない）。
   */
  value: string;
}

interface Item {
  /** カード見出し。HTML断片可（set:html で描画、name属性と同じ信頼境界） */
  name: string;
  attributes: Attribute[];
  /** 強調表示するカード（おすすめ・登録済 等） */
  highlight?: boolean;
  /** highlight時のバッジ文言（既定: "おすすめ"） */
  highlightLabel?: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<div class="my-4 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3" role="list">
  {
    items.map((item) => (
      <div
        role="listitem"
        class={`rounded-xl p-4 ${
          item.highlight
            ? 'border-2 border-accent-1 bg-accent-1/5'
            : 'border border-border-soft bg-card'
        }`}
      >
        <div class="mb-2 flex flex-wrap items-center gap-2">
          <strong class="font-display text-sm font-semibold text-ink-1" set:html={item.name} />
          {item.highlight && (
            <span class="rounded-full bg-accent-1 px-2 py-0.5 text-[10px] font-semibold text-white">
              {item.highlightLabel ?? 'おすすめ'}
            </span>
          )}
        </div>
        <dl class="m-0 space-y-1.5">
          {item.attributes.map((attr) => (
            <div class="text-xs leading-relaxed">
              <dt class="inline font-semibold text-ink-2">{attr.label}：</dt>
              <dd class="m-0 inline text-ink-1" set:html={attr.value} />
            </div>
          ))}
        </dl>
      </div>
    ))
  }
</div>
