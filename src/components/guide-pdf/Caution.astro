---
interface Props {
  title?: string;
  level?: 'warn' | 'info';
}

const { title, level = 'warn' } = Astro.props;
const panelClass = level === 'warn' ? 'gp-panel-warn' : 'gp-panel';
const titleColor = level === 'warn' ? 'text-guide-ng-border' : 'text-guide-accent';
---

<div class={`my-4 ${panelClass}`}>
  {title && <p class={`m-0 mb-2 text-sm font-bold ${titleColor}`}>{title}</p>}
  <div class="text-sm leading-relaxed text-guide-ink [&>:last-child]:mb-0">
    <slot />
  </div>
</div>
