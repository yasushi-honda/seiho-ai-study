---
interface Branch {
  /** 分岐点となる質問 */
  question: string;
  /** YES の場合の結果ラベル */
  yes: string;
  /** NO の場合の結果ラベル（次の質問に進む場合は "→ 次の質問へ" 等） */
  no: string;
}

interface Props {
  branches: Branch[];
}

const { branches } = Astro.props;
---

<div class="my-4" role="list">
  {
    branches.map((b, i) => (
      <>
        <div
          role="listitem"
          class="rounded-xl border border-border-soft bg-card p-4"
        >
          <p class="font-display m-0 mb-2 text-sm font-semibold text-ink-1">{b.question}</p>
          <div class="flex flex-wrap gap-2 text-xs">
            <span class="rounded-full bg-accent-1/10 px-3 py-1 font-semibold text-accent-1-deep">
              <span aria-hidden="true">✅</span> {b.yes}
            </span>
            <span class="rounded-full bg-warn-soft px-3 py-1 font-semibold text-warn">
              <span aria-hidden="true">⚠</span> {b.no}
            </span>
          </div>
        </div>
        {i < branches.length - 1 && (
          <div class="flex justify-center py-1" aria-hidden="true">
            <span class="font-display text-lg text-accent-1">↓</span>
          </div>
        )}
      </>
    ))
  }
</div>
