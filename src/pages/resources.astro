---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../lib/urls';

interface Link {
  title: string;
  url: string;
  note?: string;
}

interface ResourceSection {
  title: string;
  icon: string;
  description: string;
  links: Link[];
}

const sections: ResourceSection[] = [
  {
    title: '法令・公的ガイドライン',
    icon: '⚖️',
    description: '個人情報・福祉現場における基本ルール',
    links: [
      {
        title: '医療・介護関係事業者における個人情報の適切な取扱いのためのガイダンス（個人情報保護委員会）',
        url: 'https://www.ppc.go.jp/personalinfo/legal/iryoukaigo_guidance/',
        note: '社会福祉施設にも準用される現行ガイダンス',
      },
      {
        title: '個人情報保護法（e-Gov 法令検索）',
        url: 'https://laws.e-gov.go.jp/law/415AC0000000057',
        note: '要配慮個人情報（第2条3項）・委託先の監督（第25条）など。2026年7月に改正法が公布されたが、2026年8月時点で主要部分は未施行',
      },
      {
        title: 'ISMAP 政府情報システムのためのセキュリティ評価制度',
        url: 'https://www.ismap.go.jp/',
        note: 'クラウドサービスリスト・選定時の根拠資料',
      },
      {
        title: '厚生労働省 個人情報保護関連ページ',
        url: 'https://www.mhlw.go.jp/stf/seisakunitsuite/bunya/0000027272.html',
        note: 'ガイドライン本体・Q&A',
      },
    ],
  },
  {
    title: 'AI サービス公式',
    icon: '🤖',
    description: '法人契約・データ取扱いは必ず公式ヘルプで確認',
    links: [
      {
        title: 'Google Gemini',
        url: 'https://gemini.google.com/',
        note: '個人アプリ。Workspace連携で法人利用。本研修のメインツール',
      },
      {
        title: 'Google Workspace with Gemini',
        url: 'https://workspace.google.com/solutions/ai/',
        note: '法人データは学習対象外（デフォルト）',
      },
      {
        title: 'Gemini Notebook（旧NotebookLM）',
        url: 'https://notebook.google.com/',
        note: '2026年7月にNotebookLMから改称。個人版・出典付き回答。法令検索・施設知識基盤に',
      },
      {
        title: 'Gemini Notebook Enterprise（Google Cloud、旧NotebookLM Enterprise）',
        url: 'https://cloud.google.com/resources/notebooklm-enterprise',
        note: 'ISMAP 本登録済。政府・自治体・関連団体の調達対応',
      },
      {
        title: 'ChatGPT（OpenAI）',
        url: 'https://chatgpt.com/',
        note: '参考：本研修では主に使用しませんが、既にお使いの方向けに紹介',
      },
      {
        title: 'Anthropic Claude',
        url: 'https://claude.com/',
        note: '参考：本研修では主に使用しませんが、既にお使いの方向けに紹介',
      },
    ],
  },
  {
    title: '音声・文字起こしツール',
    icon: '🎙️',
    description: '法人契約・データ学習設定は必ず確認',
    links: [
      {
        title: 'Notta',
        url: 'https://www.notta.ai/business',
        note: '日本語精度・話者識別。法人向け上位プランで「AI学習に使わない」設定がデフォルト',
      },
      {
        title: 'LINE WORKS AiNote（旧CLOVA Note）',
        url: 'https://line-works.com/ainote/',
        note: '日本語特化、要約機能内蔵。旧CLOVA Noteβ版は2025年7月31日終了',
      },
      {
        title: 'Plaud Note',
        url: 'https://jp.plaud.ai/',
        note: 'IC レコーダー型、録音→自動連携。後継のPlaud Note Pro・NotePin Sも展開中',
      },
      {
        title: 'ミルモレコーダー（ウェルモ）',
        url: 'https://lp.recorder.milmo.jp/',
        note: '福祉・介護業界特化。SOAP・F-SOAIP テンプレート',
      },
    ],
  },
  {
    title: '福祉×AI 事例・参考記事',
    icon: '📰',
    description: '他自治体・施設の取り組み',
    links: [
      {
        title: '千葉県「いつでも福祉相談サポット」',
        url: 'https://www.pref.chiba.lg.jp/kenshidou/types/welfarechatbot.html',
        note: '生成AI チャットボット（24時間）。2026年6月時点でLINE版は不具合のためWeb版中心の運用',
      },
      {
        title: '茨城県「福祉相談業務における生成AIの活用」',
        url: 'https://www.pref.ibaraki.jp/hokenfukushi/fukushi/hogo/kurashi/20260303.html',
        note: '2025年12月開始。生活困窮者等の相談業務に生成AIを導入した県福祉事務所の事例',
      },
      {
        title: '厚生労働省「2040 年に向けたサービス提供体制等のあり方に関するとりまとめ」',
        url: 'https://www.mhlw.go.jp/stf/newpage_60080.html',
        note: '2025年7月25日公表。計画書・議事録への生成AI活用に言及（ケアプランは検討段階）',
      },
      {
        title: '宮城県「生成 AI で業務効率化」Gemini Notebook 活用事例',
        url: 'https://www.pref.miyagi.jp/documents/41848/2511_45.pdf',
        note: '県立学校教員向け情報教育通信（教育委員会）。福祉分野の事例ではない点に留意',
      },
    ],
  },
  {
    title: '学習リソース（理解を深めたい方へ）',
    icon: '📚',
    description: '時間があるときに目を通せる素材',
    links: [
      {
        title: 'デジタル庁「行政の進化と革新のための生成AIの調達・利活用に係るガイドライン」（DS-920 2.0版）',
        url: 'https://www.digital.go.jp/assets/contents/node/information/field_ref_resources/decb64eb-f26e-41cb-8d37-f3dd173108b8/59054b35/20260612_resources_standard_guidelines_guideline_01.pdf',
        note: '2026年6月12日公表、2026年9月1日適用開始。行政側のリスク対策・調達の考え方',
      },
      {
        title: 'デジタル庁「テキスト生成AI利活用におけるリスクへの対策ガイドブック」（α版）',
        url: 'https://www.digital.go.jp/resources/generalitve-ai-guidebook',
        note: '2024年5月公開・2025年6月最終更新。個別リスクとその対策の具体例',
      },
      {
        title: 'IPA「AI利用者のためのセキュリティ豆知識」',
        url: 'https://www.ipa.go.jp/digital/ai/security/ai_security_tips.html',
        note: '2026年4月公開。専門知識を問わないAI利用者・マネージャ向けの社内研修教材',
      },
    ],
  },
];
---

<Layout title="参考リンク" description="生保AIスタディの参考リンク集。法令・公的ガイドライン、AI サービス公式、文字起こしツール、福祉×AI事例。">
  <section class="container-page py-10 md:py-16">
    <header class="mb-8">
      <span class="font-display mb-2 block text-xs font-semibold uppercase tracking-widest text-accent-1">
        Resources
      </span>
      <h1 class="font-display text-3xl font-semibold leading-tight md:text-4xl">参考リンク</h1>
      <p class="mt-3 text-base text-ink-2">
        研修内容を深掘りしたい方、施設で展開する方のための一次資料リンク集。
      </p>
    </header>

    <div class="mb-8 rounded-xl border-l-4 border-warn bg-warn-soft p-4 text-sm leading-relaxed text-ink-1">
      <p class="m-0">
        <strong>⚠ 注意：</strong>
        外部リンクは2026年8月時点の公開URLです。リンク切れ・サービス停止の可能性があります。
        AI サービスの料金・仕様は変動するため、契約前に必ず最新の公式情報をご確認ください。
      </p>
    </div>

    {sections.map((s) => (
      <section class="mb-10">
        <h2 class="font-display mb-2 text-xl font-semibold md:text-2xl">
          <span aria-hidden="true">{s.icon}</span> {s.title}
        </h2>
        <p class="mb-4 text-sm text-ink-2">{s.description}</p>

        <ul class="space-y-2">
          {s.links.map((l) => (
            <li class="rounded-xl border border-border-soft bg-card p-3 md:p-4">
              <a
                href={l.url}
                target="_blank"
                rel="noopener noreferrer"
                class="font-display block text-base font-semibold text-accent-1 underline-offset-2 hover:underline"
              >
                {l.title} ↗
              </a>
              {l.note && (
                <p class="mt-1 text-xs leading-relaxed text-ink-2">{l.note}</p>
              )}
              <p class="mt-1 break-all font-mono text-[10px] text-ink-3">{l.url}</p>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <div class="mt-12 rounded-2xl border-2 border-dashed border-accent-1 bg-bg-deep p-6 text-center">
      <p class="font-display mb-2 text-base font-semibold">良いリンクが他にあれば</p>
      <p class="text-sm text-ink-2">研修当日や事後に教えていただければ追加します。</p>
      <a
        href={withBase('')}
        class="mt-4 inline-block rounded-full bg-accent-1 px-5 py-2.5 text-sm font-semibold text-white no-underline hover:bg-accent-1-deep"
      >
        トップへ戻る
      </a>
    </div>
  </section>
</Layout>
